geo:atitlan a skos:Concept ;
    skos:notation "geo.atitlan" ;
    skos:prefLabel "Atitlán"@en, "Atitlán"@es ;
    skos:altLabel "Lake Atitlán"@en ;
    skos:broader geo:guatemala ;
    skos:inScheme <https://semantic-lab.example/taxonomy/geo> .

geo:coban a skos:Concept ;
    skos:notation "geo.coban" ;
    skos:prefLabel "Cobán"@en, "Cobán"@es ;
    skos:broader geo:guatemala ;
    skos:inScheme <https://semantic-lab.example/taxonomy/geo> .

geo:honduras a skos:Concept ;
    skos:notation "geo.honduras" ;
    skos:prefLabel "Honduras"@en, "Honduras"@es ;
    skos:broader geo:central-america ;
    skos:inScheme <https://semantic-lab.example/taxonomy/geo> .

geo:copan a skos:Concept ;
    skos:notation "geo.copan" ;
    skos:prefLabel "Copán"@en, "Copán"@es ;
    skos:broader geo:honduras ;
    skos:inScheme <https://semantic-lab.example/taxonomy/geo> .

geo:marcala a skos:Concept ;
    skos:notation "geo.marcala" ;
    skos:prefLabel "Marcala"@en, "Marcala"@es ;
    skos:broader geo:honduras ;
    skos:inScheme <https://semantic-lab.example/taxonomy/geo> .

geo:santa-barbara a skos:Concept ;
    skos:notation "geo.santa-barbara" ;
    skos:prefLabel "Santa Bárbara"@en, "Santa Bárbara"@es ;
    skos:broader geo:honduras ;
    skos:inScheme <https://semantic-lab.example/taxonomy/geo> .

geo:el-paraiso a skos:Concept ;
    skos:notation "geo.el-paraiso" ;
    skos:prefLabel "El Paraíso"@en, "El Paraíso"@es ;
    skos:broader geo:honduras ;
    skos:inScheme <https://semantic-lab.example/taxonomy/geo> .
